# ==========================================
# Vakalat AI — Environment Variables
# ==========================================

# Google Gemini API Key (Required if using Gemini embeddings / LLM)
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Embedding Provider: 'gemini' (default if GOOGLE_API_KEY is set) or 'local' (sentence-transformers)
EMBEDDING_PROVIDER=local

# ChromaDB Settings
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=indian_laws
